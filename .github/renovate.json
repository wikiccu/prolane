{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["gomod", "github-actions", "custom.regex"],
  "timezone": "Etc/UTC",
  "schedule": ["* * * * 1"],
  "prConcurrentLimit": 3,
  "automerge": false,
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": [
        "golangci/golangci-lint",
        "golang.org/x/vuln",
        "github.com/zricethezav/gitleaks/v8"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update security tool installs in CI and the README together",
      "managerFilePatterns": [".github/workflows/security.yml", "README.md"],
      "matchStrings": [
        "go install (?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v[^\\s]+)",
        "go install (?<depName>github\\.com/zricethezav/gitleaks/v8)@(?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Keep the README golangci-lint label and release link aligned with CI",
      "managerFilePatterns": ["README.md"],
      "matchStrings": [
        "\\[golangci-lint (?<currentValue>v[^\\s\\]]+)\\]",
        "https://github\\.com/golangci/golangci-lint/releases/tag/(?<currentValue>v[^\\s)]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ]
}
